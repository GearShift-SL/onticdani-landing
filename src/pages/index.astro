---
import Layout from '~/layouts/Layout.astro';
import { Image } from 'astro:assets';
import avatar from '~/assets/images/avatar.jpg';
import { SOCIALS } from '~/config';

const socials = SOCIALS();

const links = [
  {
    label: 'Instagram',
    href: socials.instagram,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`,
  },
  {
    label: 'TikTok',
    href: socials.tiktok,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M21 7.917v4.034a9.948 9.948 0 0 1 -5 -1.951v4.5a6.5 6.5 0 1 1 -8 -6.326v4.326a2.5 2.5 0 1 0 4 2v-11.5h4.083a6.005 6.005 0 0 0 4.917 4.917z"/></svg>`,
  },
  {
    label: 'X (Twitter)',
    href: socials.x,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg>`,
  },
  {
    label: 'YouTube',
    href: socials.youtube,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8z"/><path d="M10 9l5 3l-5 3z"/></svg>`,
  },
];
---

<Layout
  metadata={{
    title: '@onticdani',
    description: 'Content creator. Follow me on social media for daily content.',
  }}
>
  <main class="min-h-screen flex flex-col items-center justify-center px-4 py-16">
    <div class="w-full max-w-sm flex flex-col items-center gap-6">
      <!-- Profile -->
      <div class="flex flex-col items-center gap-3 text-center">
        <Image
          src={avatar}
          alt="@onticdani"
          width={192}
          height={192}
          densities={[1, 2, 3]}
          class="w-24 h-24 rounded-full object-cover ring-2 ring-primary/30"
        />
        <h1 class="text-2xl font-bold tracking-tight">@onticdani</h1>
        <p class="text-sm text-muted max-w-xs leading-relaxed">Te gustan los coches? A mí también!</p>
      </div>

      <!-- Social links -->
      <div class="w-full flex flex-col gap-3">
        {
          links.map(({ label, href, icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 w-full border border-gray-200 dark:border-gray-700 rounded-xl px-5 py-4 hover:border-primary hover:text-primary transition-colors duration-150 group"
            >
              <span class="shrink-0 text-muted group-hover:text-primary transition-colors" set:html={icon} />
              <span class="flex-1 font-medium">{label}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 text-muted group-hover:text-primary transition-colors"
              >
                <path d="M9 18l6-6-6-6" />
              </svg>
            </a>
          ))
        }
      </div>

      <!-- Share button -->
      <button
        id="share-btn"
        class="flex items-center gap-2 px-6 py-2.5 rounded-full border border-gray-200 dark:border-gray-700 text-sm font-medium hover:border-primary hover:text-primary transition-colors duration-150 hover:cursor-pointer"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M6 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path>
          <path d="M18 6m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path>
          <path d="M18 18m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path>
          <path d="M8.7 10.7l6.6 -3.4"></path>
          <path d="M8.7 13.3l6.6 3.4"></path>
        </svg>
        <span id="share-label">Compartir</span>
      </button>
    </div>
  </main>

  <script>
    const btn = document.getElementById('share-btn');
    const label = document.getElementById('share-label');

    btn?.addEventListener('click', async () => {
      const url = window.location.href;
      if (navigator.share) {
        await navigator.share({ title: '@onticdani', url });
      } else {
        await navigator.clipboard.writeText(url);
        if (label) {
          label.textContent = 'Copied!';
          setTimeout(() => {
            label.textContent = 'Share';
          }, 2000);
        }
      }
    });
  </script>
</Layout>
